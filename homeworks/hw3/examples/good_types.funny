function sum(a:int[], n:int)
    requires n >= 0 and n <= length(a)
    returns r:int
    ensures r >= 0
    uses i:int, copy:int[]
{
    copy = a;
    i = 0;
    r = 0;
    while (i < n) invariant i >= 0 and i <= n {
        if (copy[i] > 0) {
            r = r + copy[i];
        } else {
            assume copy[i] <= 0;
        }
        i = i + 1;
    }
    assert r >= 0;
}
